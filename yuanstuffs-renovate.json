{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"group:allNonMajor",
		":automergeStableNonMajor",
		":automergeMinor",
		":semanticCommits",
		":disableRateLimiting",
		":prImmediately"
	],
	"timezone": "Asia/Kuala_Lumpur",
	"schedule": ["before 12pm on Sunday"],
	"labels": ["dependencies"],
	"reviewers": ["yuansheng1549"],
	"automergeStrategy": "squash",
	"npm": {
		"postUpdateOptions": ["yarnDedupeHighest"],
		"rangeStrategy": "bump",
		"minimumReleaseAge": "2 days",
		"packageRules": [
			{
				"matchUpdateTypes": ["patch"],
				"matchCurrentVersion": "/^0\\./",
				"automerge": true,
				"platformAutomerge": true
			},
			{
				"matchUpdateTypes": ["minor", "patch"],
				"matchCurrentVersion": ">=1.0.0",
				"automerge": true,
				"platformAutomerge": true
			},
			{
				"matchPackageNames": ["mongoose"],
				"description": "pin mongoose version to v6",
				"allowedVersions": "^6"
			},
			{
				"matchPackageNames": ["typescript"],
				"description": "only allow renovate bump typescript version to 5.9",
				"allowedVersions": "<=5.9"
			},
			{
				"matchPackageNames": ["eslint"],
				"description": "pin eslint to v8",
				"allowedVersions": "^8"
			},
			{
				"matchSourceUrls": ["https://github.com/typescript-eslint/typescript-eslint"],
				"description": "pin @typescript-eslint/* to v7",
				"allowedVersions": "^7"
			},
			{
				"matchPackageNames": ["@types/node"],
				"description": "pin @types/node to v24",
				"allowedVersions": "^24",
				"automerge": true,
				"platformAutomerge": true
			}
		]
	},
    "dockerfile": {
        "semanticCommitType": "build"
    },
    "vulnerabilityAlerts": {
        "enabled": true,
        "automerge": true,
        "assignees": ["yuansheng1549"]
    }
}
